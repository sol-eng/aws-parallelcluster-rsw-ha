# Settings for one ParallelCluster deployment, read by deploy.sh.
#
#   cp envs/demo.env.example envs/demo.env   # *.env files are git-ignored
#   ./deploy.sh envs/demo.env [--dry-run]
#
# Everything else (DB endpoints, secrets, subnets, security groups, IAM
# policies, S3 bucket, AD) is read from the Pulumi stack outputs.

# Cluster name. Must match the Pulumi stack name, because the ALB target
# groups and DNS records created by Pulumi are named after the stack.
CLUSTERNAME="demo"
# Pulumi stack to read outputs from (defaults to CLUSTERNAME)
STACKNAME="$CLUSTERNAME"

REGION="eu-west-1"

# Custom AMI built with image/build-image.sh
AMI="ami-xxxxxxxxxxxxxxxxx"

# Posit Workbench version, see https://posit.co/download/rstudio-server-pro/
PWB_VERSION="2026.04.0-526.pro2"

# Cluster template: config/cluster-config-wb.<CONFIG>.tmpl (default | easybuild)
CONFIG="default"

# Only for CONFIG=easybuild: existing EFS with the EasyBuild stack in /opt/apps
#APPS_EFS_ID="fs-xxxxxxxxxxxxxxxxx"

# CIDR allowed to SSH into head and login nodes
ALLOWEDIPS="10.0.0.0/16"

# Internal host names given to the login nodes (node1.<HPC_DOMAIN>, ...)
# and, with SSL=true, the domain of the self-signed certificate
HPC_DOMAIN="hpc.example.com"
HPC_HOST="demo"

# Feature flags (true | false)
# SSL: let Workbench itself serve TLS with a self-signed *.HPC_DOMAIN cert.
#      With false, TLS is terminated at the Pulumi-managed ALBs (recommended).
SSL=false
# Container (Apptainer/Singularity) sessions via the SPANK plugin
SINGULARITY_SUPPORT=true
# Lmod/EasyBuild software modules (use with CONFIG=easybuild)
EASYBUILD_SUPPORT=false
# Tiny resource profiles for load testing
BENCHMARK_SUPPORT=false
# Additionally offer the Local launcher on the login nodes
LOCAL=false

# Subject of the self-signed certificate (SSL=true only)
#CERT_SUBJECT="/O=My Org/CN=*.$HPC_DOMAIN"
