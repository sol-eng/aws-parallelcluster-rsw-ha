HeadNode:
  CustomActions:
    OnNodeConfigured:
      Script: "s3://@@S3_PREFIX@@/install-pwb-config.sh"
      Args:
        - "@@PWB_VERSION@@"
        - "@@HPC_DOMAIN@@"
        - "@@HPC_HOST@@"
  Iam:
    S3Access:
      - BucketName: @@S3_BUCKETNAME@@
    AdditionalIamPolicies:
      - Policy: arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore
      - Policy: @@ELB_ACCESS@@
      - Policy: @@EC2_RUNINSTANCES@@
  InstanceType: t3.xlarge
  Networking:
    SubnetId: @@SUBNETID@@
    AdditionalSecurityGroups:
      - @@SECURITYGROUP_SSH@@
  LocalStorage:
    RootVolume:
      Size: 120
  SharedStorageType: Efs
  SharedStorageEfsSettings:
    Encrypted: true
  Ssh:
    AllowedIps: @@ALLOWEDIPS@@
Image:
  Os: ubuntu2404
  CustomAmi: @@AMI@@
Region: @@REGION@@
Scheduling:
  Scheduler: slurm
  SlurmSettings:
    Dns:
      DisableManagedDns: true
      UseEc2Hostnames: true
    EnableMemoryBasedScheduling: true
    Database:
      Uri: @@SLURM_DB_HOST@@
      UserName: @@SLURM_DB_USER@@
      PasswordSecretArn: @@SLURM_DB_PASS_ARN@@
      DatabaseName: @@SLURM_DB_NAME@@
  SlurmQueues:

    - Name: interactive
      ComputeResources:
        - Name: rstudio
          InstanceType: t3.xlarge
          MaxCount: 5
          MinCount: 1
          Efa:
            Enabled: FALSE
      CustomSlurmSettings:
        OverSubscribe: FORCE:2
      CustomActions:
        OnNodeConfigured:
          Script: "s3://@@S3_PREFIX@@/config-compute.sh"
          Args:
            - "@@PWB_VERSION@@"
      Iam:
        S3Access:
          - BucketName: @@S3_BUCKETNAME@@
      Networking:
        PlacementGroup:
          Enabled: FALSE
        SubnetIds:
          - @@SUBNETID@@

    - Name: all
      ComputeResources:
        - Name: rstudio
          InstanceType: t3.xlarge
          MaxCount: 10
          MinCount: 0
          Efa:
            Enabled: FALSE
      CustomActions:
        OnNodeConfigured:
          Script: "s3://@@S3_PREFIX@@/config-compute.sh"
          Args:
            - "@@PWB_VERSION@@"
      Iam:
        S3Access:
          - BucketName: @@S3_BUCKETNAME@@
      Networking:
        PlacementGroup:
          Enabled: FALSE
        SubnetIds:
          - @@SUBNETID@@

    - Name: gpu
      ComputeResources:
        - Name: large
          InstanceType: g4dn.xlarge
          MaxCount: 5
          MinCount: 0
          Efa:
            Enabled: FALSE
      CustomActions:
        OnNodeConfigured:
          Script: "s3://@@S3_PREFIX@@/config-compute.sh"
          Args:
            - "@@PWB_VERSION@@"
      Iam:
        S3Access:
          - BucketName: @@S3_BUCKETNAME@@
      Networking:
        PlacementGroup:
          Enabled: FALSE
        SubnetIds:
          - @@SUBNETID@@


LoginNodes:
  Pools:
    - Name: login
      Count: 2
      InstanceType: t3.xlarge
      CustomActions:
        OnNodeConfigured:
          Script: "s3://@@S3_PREFIX@@/config-login.sh"
          Args:
            - "/opt/rstudio/etc/rstudio"
            - "@@PWB_VERSION@@"
      Networking:
        AdditionalSecurityGroups:
          - @@SECURITYGROUP_RSW@@
        SubnetIds:
          - @@SUBNETID@@
      Ssh:
        AllowedIps: @@ALLOWEDIPS@@
      Iam:
        AdditionalIamPolicies:
          - Policy: @@S3_ACCESS@@

DevSettings:
  Timeouts:
    HeadNodeBootstrapTimeout: 7200  # timeout in seconds
    ComputeNodeBootstrapTimeout: 7200  # timeout in seconds

SharedStorage:
  - MountDir: /home
    Name: home
    StorageType: Efs
    EfsSettings:
      Encrypted: true
      EncryptionInTransit: true
  - MountDir: /opt/rstudio
    Name: rstudio
    StorageType: Efs
    EfsSettings:
      Encrypted: true
      EncryptionInTransit: true

DirectoryService:
  DomainName: @@AD_DOMAIN@@
  DomainAddr: ldap://@@AD_DOMAIN@@
  PasswordSecretArn: @@AD_PASSWORD_ARN@@
  DomainReadOnlyUser: cn=Administrator,cn=Users,@@AD_BASE_DN@@
  GenerateSshKeysForUsers: true
  AdditionalSssdConfigs:
    override_homedir : /home/%u
    ldap_id_use_start_tls : false
    ldap_tls_reqcert : never
    ldap_auth_disable_tls_never_use_in_production : true

Tags:
  - Key: rs:environment
    Value: development
  - Key: rs:owner
    Value: @@EMAIL@@
  - Key: rs:project
    Value: solutions
  - Key: rs:subsystem
    Value: @@BILLING_CODE@@
